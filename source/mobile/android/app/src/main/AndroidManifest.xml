<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:versionCode="::APP_BUILD_NUMBER::" android:versionName="::APP_VERSION::" android:installLocation="::ANDROID_INSTALL_LOCATION::">

	<uses-feature android:glEsVersion="0x00020000" android:required="true" />
	<uses-feature android:name="android.hardware.touchscreen" android:required="false" />

	::foreach ANDROID_PERMISSIONS::<uses-permission android:name="::__current__::" />
	::end::

	<queries>
		<package android:name="com.leninasto.fnfmodinstaler" />
		<package android:name="com.leninasto.fnfmodinstaller" />
	</queries>

	<application ::if (ANDROID_TARGET_SDK_VERSION >= 33)::android:enableOnBackInvokedCallback="true" ::end::::foreach ANDROID_APPLICATION::::if ((value != null) && (value != ""))::::key::="::value::" ::end::::end::>

		::if (WIN_ORIENTATION=="portrait")::
		<meta-data android:name="SDL_ENV.SDL_IOS_ORIENTATIONS" android:value="Portrait PortraitUpsideDown" />
		::elseif (WIN_ORIENTATION=="landscape")::
		<meta-data android:name="SDL_ENV.SDL_IOS_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />
		::end::

		<activity
			android:name="::APP_PACKAGE::.launcher.EngineLauncherActivity"
			android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
			android:exported="true"
			android:label="::APP_TITLE::"
			android:launchMode="singleTask"
			android:resizeableActivity="true"
			android:screenOrientation="fullUser">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<category android:name="tv.ouya.intent.category.GAME" />
			</intent-filter>

		</activity>

		<activity
			android:name="::APP_PACKAGE::.MainActivity"
			android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
			android:exported="false"
			android:label="::APP_TITLE::"
			android:launchMode="singleTask"
			android:process=":game"
			android:resizeableActivity="false"
			android:screenOrientation="sensorLandscape">

			::foreach ANDROID_ACCEPT_FILE_INTENT::
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="::__current__::" />
			</intent-filter>
			::end::

		</activity>

		<activity
			android:name="::APP_PACKAGE::.EngineCrashActivity"
			android:label="@string/plus_launcher_recovery_title"
			android:theme="@style/LimeAppMainTheme"
			android:process=":lime_crash"
			android:excludeFromRecents="true"
			android:exported="false" />

		<activity
			android:name="org.haxe.lime.LimeCrashActivity"
			android:label="@string/plus_launcher_recovery_title"
			android:theme="@style/LimeAppMainTheme"
			android:process=":lime_crash"
			android:excludeFromRecents="true"
			android:exported="false" />

		::if (ANDROID_USE_ANDROIDX)::
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="::APP_PACKAGE::.provider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
		::end::

		::if (SHARE_FILES)::
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="::APP_PACKAGE::.contentprovider"
			android:exported="true"
			android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/provider_paths" />
		</provider>
		::end::

		::if (SHARE_FILES)::
		<provider
			android:name="org.haxe.lime.StorageProvider"
			android:authorities="::APP_PACKAGE::.documentsprovider"
			android:exported="true"
			android:grantUriPermissions="true"
			::if (ANDROID_USE_ANDROIDX)::
			android:permission="android.permission.MANAGE_DOCUMENTS">
			::end::
			<intent-filter>
				<action android:name="android.content.action.DOCUMENTS_PROVIDER" />
			</intent-filter>
		</provider>
		::end::

	</application>

</manifest>
