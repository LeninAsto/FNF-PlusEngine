---
import { Badge } from '@astrojs/starlight/components';

interface Props {
  id: string;
  name: string;
  aliases: string[];
  status: 'verified' | 'needs-review';
  video: string | null;
  description: string;
  videoNote?: string;
  locale?: 'en' | 'es-LA';
}

const props = Astro.props;
const es = props.locale === 'es-LA';
---

<section class="modifier" aria-labelledby={props.id}>
  <h2 id={props.id}>{props.name}</h2>
  <Badge text={props.status === 'verified' ? (es ? 'Verificado' : 'Verified') : (es ? 'Necesita revisión' : 'Needs review')} variant={props.status === 'verified' ? 'success' : 'caution'} />
  <p>{props.description}</p>
  <p><strong>{es ? 'Aliases:' : 'Aliases:'}</strong> {props.aliases.map((alias) => <code>{alias}</code>)}</p>
  {
    props.video && (
      <figure>
        <video controls playsinline preload="none">
          <source src={`/videos/${props.video}`} type="video/mp4" />
        </video>
        {props.videoNote && <figcaption>{props.videoNote}</figcaption>}
      </figure>
    )
  }
</section>

<style>
  .modifier {
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 2.5rem;
    padding-top: 1rem;
  }

  code + code {
    margin-inline-start: 0.4rem;
  }

  video {
    background: #000;
    border-radius: 0.75rem;
    display: block;
    max-height: 32rem;
    max-width: 100%;
    width: 100%;
  }

  figcaption {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin-top: 0.5rem;
  }
</style>
