---
import { Badge } from '@astrojs/starlight/components';

interface Props {
  id: string;
  signature: string;
  origin: 'psych-upstream' | 'plus-added' | 'plus-modified';
  status: 'verified' | 'needs-review' | 'unsupported' | 'deprecated';
  available: string[];
  sourceLinks: { label: string; url: string }[];
  testedAtCommit: string | null;
  description: string;
  locale?: 'en' | 'es-LA';
}

const props = Astro.props;
const es = props.locale === 'es-LA';
const labels = {
  'psych-upstream': 'Psych upstream',
  'plus-added': es ? 'Agregada por Plus' : 'Added by Plus',
  'plus-modified': es ? 'Modificada por Plus' : 'Modified by Plus'
};
const statuses = {
  verified: { text: es ? 'Verificada' : 'Verified', variant: 'success' as const },
  'needs-review': { text: es ? 'Necesita revisión' : 'Needs review', variant: 'caution' as const },
  unsupported: { text: es ? 'No compatible' : 'Unsupported', variant: 'danger' as const },
  deprecated: { text: es ? 'Obsoleta' : 'Deprecated', variant: 'note' as const }
};
---

<section class="api-entry" aria-labelledby={props.id}>
  <h2 id={props.id}><code>{props.id}</code></h2>
  <div class="badges">
    <Badge text={labels[props.origin]} variant="note" />
    <Badge text={statuses[props.status].text} variant={statuses[props.status].variant} />
  </div>
  <pre><code>{props.signature}</code></pre>
  <p>{props.description}</p>
  {
    props.available.length > 0 ? (
      <p><strong>{es ? 'Disponible en:' : 'Available in:'}</strong> {props.available.join(', ')}</p>
    ) : (
      <p><strong>{es ? 'Versiones verificadas:' : 'Verified versions:'}</strong> {es ? 'ninguna todavía' : 'none yet'}</p>
    )
  }
  <p class="sources">
    <strong>{es ? 'Fuentes:' : 'Sources:'}</strong>{' '}
    {props.sourceLinks.map((source, index) => (
      <><a href={source.url}>{source.label}</a>{index < props.sourceLinks.length - 1 ? ', ' : ''}</>
    ))}
  </p>
</section>

<style>
  .api-entry {
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 2.5rem;
    padding-top: 1rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.75rem;
  }

  .sources {
    font-size: var(--sl-text-sm);
  }
</style>
