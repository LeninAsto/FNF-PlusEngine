---
import config from 'virtual:starlight/user-config';
import Select from '@astrojs/starlight/components/Select.astro';

function localizedPathname(locale: string | undefined): string {
  const current = Astro.url.pathname;
  const basePath = current === '/es-LA' ? '/' : current.replace(/^\/es-LA(?=\/)/, '');
  return locale === 'root' ? basePath : `/${locale}${basePath}`;
}

const locale = Astro.locals.starlightRoute.locale;
const automaticLabel = locale === 'es-LA' ? 'Automático (dispositivo)' : 'Automatic (device)';
---

{
  config.isMultilingual && (
    <plus-language-select>
      <Select
        icon="translate"
        label={Astro.locals.t('languageSelect.accessibleLabel')}
        options={[
          { value: '__automatic__', selected: false, label: automaticLabel },
          ...Object.entries(config.locales).map(([code, localeConfig]) => ({
            value: localizedPathname(code),
            selected: code === locale,
            label: localeConfig!.label
          }))
        ]}
        width="12em"
      />
    </plus-language-select>
  )
}

<script>
  const storageKey = 'plus-docs-locale';

  function deviceLocale() {
    const preferences = navigator.languages?.length ? navigator.languages : [navigator.language];
    return preferences.some((tag) => tag.toLowerCase().startsWith('es')) ? 'es-LA' : 'en';
  }

  class PlusLanguageSelect extends HTMLElement {
    constructor() {
      super();
      const select = this.querySelector('select');
      if (!select) return;

      select.addEventListener('change', () => {
        if (select.value === '__automatic__') {
          localStorage.removeItem(storageKey);
          const targetLocale = deviceLocale();
          const option = [...select.options].find((item) =>
            targetLocale === 'es-LA'
              ? item.value.startsWith('/es-LA/')
              : item.value !== '__automatic__' && !item.value.startsWith('/es-LA/')
          );
          if (option) window.location.assign(`${option.value}${window.location.search}${window.location.hash}`);
          return;
        }

        localStorage.setItem(storageKey, select.value.startsWith('/es-LA/') ? 'es-LA' : 'en');
        window.location.assign(`${select.value}${window.location.search}${window.location.hash}`);
      });

      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        const selected = select.querySelector<HTMLOptionElement>('option[selected]');
        if (selected) select.selectedIndex = selected.index;
      });
    }
  }

  customElements.define('plus-language-select', PlusLanguageSelect);
</script>
