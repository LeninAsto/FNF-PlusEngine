{
  "setCameraScroll": {
    "description": "Sets the camera's scroll position directly.",
    "parameters": {
      "x": "X scroll position.",
      "y": "Y scroll position."
    },
    "examples": []
  },
  "cameraSetTarget": {
    "description": "Makes the camera follow a character.",
    "parameters": {
      "character": "Character name: 'bf', 'dad', 'gf', etc."
    },
    "examples": [
      "Camera follows the boyfriend.",
      "Camera follows the opponent."
    ]
  },
  "cameraShake": {
    "description": "Creates a camera shake effect.",
    "parameters": {
      "camera": "Camera identifier ('hud', 'game', etc).",
      "intensity": "Shake strength.",
      "duration": "Shake duration in seconds."
    },
    "examples": []
  },
  "cameraFlash": {
    "description": "Flashes the camera with a color.",
    "parameters": {
      "camera": "Camera identifier.",
      "color": "Flash color as hex or name.",
      "duration": "Flash duration in seconds.",
      "forced": "Force the flash. Defaults to false."
    },
    "examples": []
  },
  "cameraFade": {
    "description": "Fades the camera in or out.",
    "parameters": {
      "camera": "Camera identifier.",
      "color": "Fade color.",
      "duration": "Fade duration in seconds.",
      "toAlpha": "End transparency (0-1). Defaults to 1.",
      "fromAlpha": "Start transparency (0-1). Defaults to 0."
    },
    "examples": []
  }
}
